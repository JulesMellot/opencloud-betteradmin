{
  "name": "web-app-betteradmin",
  "version": "0.1.1",
  "description": "A native OpenCloud extension providing administrators with clearer storage insights.",
  "license": "Apache-2.0",
  "author": "BetterAdmin contributors",
  "private": true,
  "homepage": "https://github.com/julesmellot/opencloud-betteradmin",
  "type": "module",
  "scripts": {
    "build": "pnpm vite build",
    "build:w": "pnpm vite build --watch --mode development",
    "check:types": "vue-tsc --noEmit",
    "lint": "eslint 'src/**/*.{js,ts,vue}' --color",
    "format:check": "prettier . --check",
    "format:write": "prettier . --write",
    "test:unit": "NODE_OPTIONS=--unhandled-rejections=throw vitest"
  },
  "devDependencies": {
    "@opencloud-eu/design-system": "^8.0.0",
    "@opencloud-eu/eslint-config": "^8.0.0",
    "@opencloud-eu/extension-sdk": "^8.0.0",
    "@opencloud-eu/prettier-config": "^8.0.0",
    "@opencloud-eu/tsconfig": "^8.0.0",
    "@opencloud-eu/web-client": "^8.0.0",
    "@opencloud-eu/web-pkg": "^8.0.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.0.0",
    "happy-dom": "^20.0.0",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0",
    "vue": "^3.5.13",
    "vue-router": "^5.0.0",
    "vue-tsc": "^3.0.0",
    "vue3-gettext": "^4.0.0"
  },
  "packageManager": "pnpm@11.27.0"
}
